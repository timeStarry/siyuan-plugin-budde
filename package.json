    "package:plugin": "node scripts/build.mjs && node scripts/package.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
